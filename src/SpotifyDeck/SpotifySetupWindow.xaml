<Window x:Class="SpotifyDeck.SpotifySetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurer Spotify"
        Width="520" Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#171717"
        Foreground="White">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Connexion Spotify officielle"
                   FontSize="22"
                   FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1"
                   Margin="0,10,0,16"
                   Foreground="#AAAAAA"
                   TextWrapping="Wrap"
                   Text="SpotifyDeck utilise maintenant uniquement l'API officielle Spotify. Pour un projet personnel, Spotify demande un Client ID. Crée une application dans Spotify for Developers, ajoute l'URI de redirection ci-dessous, puis colle le Client ID."/>

        <StackPanel Grid.Row="2">
            <TextBlock Text="URI de redirection" Foreground="#A0A0A0" FontSize="11"/>
            <Grid Margin="0,5,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="RedirectBox"
                         Text="http://127.0.0.1:43821/callback/"
                         IsReadOnly="True"
                         Height="36"
                         Padding="10,7"
                         Foreground="White"
                         Background="#242424"
                         BorderBrush="#3A3A3A"/>
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Width="80"
                        Click="CopyRedirect_Click"
                        Content="Copier"/>
            </Grid>

            <TextBlock Text="Client ID" Foreground="#A0A0A0" FontSize="11"/>
            <TextBox x:Name="ClientIdBox"
                     Height="36"
                     Margin="0,5,0,0"
                     Padding="10,7"
                     Foreground="White"
                     Background="#242424"
                     BorderBrush="#3A3A3A"/>
        </StackPanel>

        <TextBlock x:Name="HintText"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="#7F7F7F"
                   FontSize="11"
                   Text="Le Client ID est public. Aucun Client Secret n'est demandé."/>

        <Button Grid.Row="4"
                Margin="0,18,0,0"
                Height="38"
                VerticalAlignment="Top"
                Click="OpenDashboard_Click"
                Content="Ouvrir Spotify for Developers"/>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90"
                    Margin="0,0,8,0"
                    Click="Cancel_Click"
                    Content="Annuler"/>
            <Button Width="120"
                    Click="Save_Click"
                    Content="Enregistrer"/>
        </StackPanel>
    </Grid>
</Window>