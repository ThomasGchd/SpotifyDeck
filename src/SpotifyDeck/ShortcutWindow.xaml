<Window x:Class="SpotifyDeck.ShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raccourci SpotifyDeck" Width="420" Height="235"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#171717" Foreground="White">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Raccourci global" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Margin="0,10,0,14"
                       Foreground="#A0A0A0"
                       TextWrapping="Wrap"
                       Text="Clique ci-dessous puis appuie sur la combinaison que tu veux utiliser. Il faut au moins Ctrl, Alt, Shift ou la touche Windows."/>

            <TextBox x:Name="CaptureBox"
                     Height="42"
                     Padding="12,8"
                     IsReadOnly="True"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Foreground="White"
                     Background="#252525"
                     BorderBrush="#3A3A3A"
                     CaretBrush="Transparent"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     PreviewKeyDown="CaptureBox_PreviewKeyDown"/>

            <TextBlock x:Name="HintText"
                       Margin="0,8,0,0"
                       Foreground="#777"
                       FontSize="11"
                       Text="Le raccourci sera testé avant d'être enregistré."/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="90" Margin="0,0,8,0" Click="Cancel_Click">Annuler</Button>
            <Button x:Name="SaveButton" Width="110" Click="Save_Click">Enregistrer</Button>
        </StackPanel>
    </Grid>
</Window>