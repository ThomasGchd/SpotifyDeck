<Window x:Class="SpotifyDeck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpotifyDeck"
        Width="920" Height="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Border CornerRadius="24"
            BorderBrush="#2F2F2F"
            BorderThickness="1"
            Background="#F2131313"
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="SpotifyDeck"
                               Foreground="White"
                               FontSize="25"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Ctrl + Alt + M · ta musique sans quitter le jeu"
                               Margin="0,4,0,0"
                               Foreground="#8C8C8C"
                               FontSize="12"/>
                </StackPanel>

                <Button x:Name="ConnectButton"
                        Grid.Column="1"
                        Padding="16,9"
                        VerticalAlignment="Center"
                        Click="ConnectButton_Click"
                        Content="Connecter Spotify"/>
            </Grid>

            <TextBox x:Name="SearchBox"
                     Grid.Row="2"
                     Height="46"
                     Padding="14,10"
                     FontSize="16"
                     Foreground="White"
                     Background="#252525"
                     BorderBrush="#3A3A3A"
                     CaretBrush="White"
                     TextChanged="SearchBox_TextChanged"
                     KeyDown="SearchBox_KeyDown"/>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="0.75*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Résultats"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <ListBox x:Name="ResultsList"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             MouseDoubleClick="ResultsList_MouseDoubleClick"
                             KeyDown="ResultsList_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,9" Margin="0,2" CornerRadius="10" Background="#1F1F1F">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Foreground="#9B9B9B"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tes playlists"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>
                    <ListBox x:Name="PlaylistsList"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="White"
                             MouseDoubleClick="PlaylistsList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,9" Margin="0,2" CornerRadius="10" Background="#1F1F1F">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="White"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="StatusText"
                       Grid.Row="5"
                       Margin="0,14,0,0"
                       Foreground="#777"
                       FontSize="11"
                       Text="SpotifyDeck prêt."/>
        </Grid>
    </Border>
</Window>
